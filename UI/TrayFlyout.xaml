<Window x:Class="ScreenShift.UI.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenShift" WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="320"
        ShowInTaskbar="False" Topmost="True">
    <Border BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel>
            <StackPanel Margin="8,10,8,6">
                <TextBlock Text="Display profiles" Margin="12,4,0,8" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FlyoutRow}" Click="Profile_Click" Tag="{Binding Profile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="{Binding ActiveVisibility}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Margin="22,0,0,0" x:Name="NameText" />
                                    <TextBlock Grid.Column="2" Text="{Binding HotkeyText}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="NameText" Property="Margin" Value="0" />
                                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="Empty" Text="No profiles yet. Open ScreenShift to save your current layout."
                           Margin="12,4,12,8" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button x:Name="UpdateRow" Style="{StaticResource FlyoutRow}" Visibility="Collapsed" Click="Update_Click" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="UpdateRowText" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="20,12">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cursor alignment" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Smooth crossing between scaled screens" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <CheckBox x:Name="Bridge" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Click="Bridge_Click" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" Padding="8"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Grid>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Left" Content="&#xE7BA;"
                            ToolTip="Restore all displays (emergency)" Click="Emergency_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Open ScreenShift" Click="Settings_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE7E8;" ToolTip="Exit ScreenShift" Click="Exit_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
